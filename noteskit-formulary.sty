\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rsc/pckg/template-package/noteskit-formulary}[2026/08/11 NotesKit - Módulo de formularios]

% ══════════════════════════════════════════════════════════════════════════════
% MÓDULO: noteskit-formulary
% Contiene: entorno y comandos para crear formularios de fórmulas organizados
%           en columnas, con soporte de imágenes, título y formato configurable.
% Dependencias: multicol, graphicx, amsmath, etoolbox (cargados por noteskit.sty
%               o el documento principal)
% ══════════════════════════════════════════════════════════════════════════════

\RequirePackage{multicol}
\RequirePackage{graphicx}
\RequirePackage{amsmath}
\RequirePackage{etoolbox}

% ──────────────────────────────────────────────────────────────────────────────
% Flags internos
% ──────────────────────────────────────────────────────────────────────────────
\newif\ifnk@formulary@istable % true si el formato actual es tabla
\nk@formulary@istablefalse


% ┌─────────────────────────────────────────────────────────────────────────────
% │ \begin{nkFormularyZone}
% │   \begin{nkFormulary}[...] ... \end{nkFormulary}
% │   \begin{nkFormulary}[...] ... \end{nkFormulary}
% │ \end{nkFormularyZone}
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Entorno wrapper que delimita una zona de formularios.
% │   - Ejecuta \clearpage al inicio (separa del texto anterior).
% │   - Aplica \pagestyle{empty} (sin header/footer/número).
% │   - Ejecuta \clearpage al final (separa del texto posterior).
% │   - Los nkFormulary internos fluyen libremente sin saltos forzados.
% │
% │ Ejemplo:
% │   \begin{nkFormularyZone}
% │     \begin{nkFormulary}[columns=3, title=Cinemática]
% │       \nkFormula{Velocidad}{$v = \frac{dx}{dt}$}
% │     \end{nkFormulary}
% │     \begin{nkFormulary}[columns=2, title=Estática, format=table]
% │       \nkFormula{Equilibrio}{$\sum F = 0$}
% │     \end{nkFormulary}
% │   \end{nkFormularyZone}
% └─────────────────────────────────────────────────────────────────────────────
% --- Keys de la zona ---
\pgfkeys{
  /nk/formularyzone/.cd,
  margin/.store in = \nk@formularyzone@margin,
  margin/.initial  = 1cm,
}

\newenvironment{nkFormularyZone}[1][]{%
  \pgfkeys{/nk/formularyzone/.cd, margin=1cm, #1}%
  \clearpage
  \pagestyle{empty}%
  \newgeometry{top=\nk@formularyzone@margin, bottom=\nk@formularyzone@margin,
               left=\nk@formularyzone@margin, right=\nk@formularyzone@margin}%
}{%
  \clearpage
  \restoregeometry
  \pagestyle{headings}%
}


% ┌─────────────────────────────────────────────────────────────────────────────
% │ \begin{nkFormulary}[opciones clave-valor]
% │   \nkFormula{nombre}{fórmula}
% │   \nkFormula[imagen.png]{nombre}{fórmula}
% │ \end{nkFormulary}
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Entorno para crear un formulario de fórmulas.
% │   - Debe usarse dentro de nkFormularyZone.
% │   - Organiza las fórmulas en N columnas o en tabla.
% │   - NO hace \clearpage por sí mismo.
% │
% │ Opciones (clave=valor):
% │   columns  = 3        (número de columnas, default: 3)
% │   title    = {}       (título opcional del formulario)
% │   format   = columns  (columns | table)
% │   colsep   = 4pt      (separación entre columnas)
% │   imwidth  = 2.5cm    (ancho por defecto de imágenes)
% │
% │ Ejemplo:
% │   \begin{nkFormulary}[columns=3, title=Cinemática, format=columns]
% │     \nkFormula{Velocidad}{$v = \frac{dx}{dt}$}
% │     \nkFormula[rsc/img/vel.png]{MRU}{$x = x_0 + vt$}
% │   \end{nkFormulary}
% └─────────────────────────────────────────────────────────────────────────────

% --- Keys del entorno ---
\pgfkeys{
  /nk/formulary/.cd,
  columns/.store in  = \nk@formulary@cols,
  columns/.initial   = 3,
  title/.store in    = \nk@formulary@title,
  title/.initial     = {},
  format/.is choice,
  format/columns/.code = {\nk@formulary@istablefalse},
  format/table/.code   = {\nk@formulary@istabletrue},
  format            = columns,
  colsep/.store in   = \nk@formulary@colsep,
  colsep/.initial    = 4pt,
  imwidth/.store in  = \nk@formulary@imwidth,
  imwidth/.initial   = 2.5cm,
}

% --- Entorno principal ---
\newenvironment{nkFormulary}[1][]{%
  % Procesar opciones (resetear defaults primero)
  \pgfkeys{/nk/formulary/.cd,
    columns=3, title={}, format=columns, colsep=4pt, imwidth=2.5cm, #1}%
  %
  % Configurar separación de columnas
  \setlength{\columnsep}{\nk@formulary@colsep}%
  %
  % Título (si se proporcionó)
  \def\nk@formulary@tmp@title{\nk@formulary@title}%
  \ifx\nk@formulary@tmp@title\empty\else
    \begin{center}
      {\large\bfseries\nk@formulary@title}%
    \end{center}
    \vspace{-0.5em}
    \hrule height 0.4pt\relax
    \vspace{0.5em}
  \fi
  %
  % Elegir formato según el flag booleano
  \ifnk@formulary@istable
    % Formato tabla
    \begingroup
    \small
    \setlength{\tabcolsep}{4pt}%
    \begin{center}
    \begin{tabular}{@{} l l @{}}
    \hline
    \textbf{Nombre} & \textbf{Fórmula} \\
    \hline
  \else
    % Formato columnas
    \begin{multicols}{\nk@formulary@cols}
    \small
    \setlength{\parindent}{0pt}%
    \setlength{\parskip}{0.4em}%
  \fi
}{%
  % Cerrar el entorno correspondiente según el flag
  \ifnk@formulary@istable
    \hline
    \end{tabular}
    \end{center}
    \endgroup
  \else
    \end{multicols}
  \fi
}


% ┌─────────────────────────────────────────────────────────────────────────────
% │ \nkFormula[imagen]{nombre}{fórmula}
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Agrega una fórmula al formulario.
% │   - nombre:  texto descriptivo de la fórmula
% │   - fórmula: expresión matemática
% │   - imagen:  (opcional) ruta a una imagen asociada
% │
% │ En formato columnas: se muestra como bloque compacto.
% │ En formato tabla: se muestra como fila de la tabla.
% │
% │ Ejemplo:
% │   \nkFormula{Velocidad}{$v = \frac{dx}{dt}$}
% │   \nkFormula[rsc/img/mru.png]{MRU}{$x = x_0 + vt$}
% └─────────────────────────────────────────────────────────────────────────────
\newcommand{\nkFormula}[3][]{%
  \ifnk@formulary@istable
    % --- Formato tabla ---
    \def\nk@tmp@img{#1}%
    \ifx\nk@tmp@img\empty
      \textbf{#2} & #3 \\
    \else
      \textbf{#2} & #3 \hfill \raisebox{-0.4\height}{\includegraphics[width=\nk@formulary@imwidth]{#1}} \\
    \fi
  \else
    % --- Formato columnas ---
    \noindent
    {\bfseries\small #2}%
    \par\nopagebreak
    \vspace{-0.3em}%
    #3%
    \def\nk@tmp@img{#1}%
    \ifx\nk@tmp@img\empty\else
      \par\nopagebreak
      \vspace{0.2em}%
%      \noindent\includegraphics[width=\nk@formulary@imwidth]{#1}% Alineada a la izquierda
      {\centering\includegraphics[width=\nk@formulary@imwidth]{#1}\par}% Centrada
    \fi
    \par
    \vspace{0.8em}%
  \fi
}

% ┌─────────────────────────────────────────────────────────────────────────────
% │ \nkFormulaInline{nombre}{fórmula}
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Versión compacta sin separador, para fórmulas muy cortas.
% └─────────────────────────────────────────────────────────────────────────────
\newcommand{\nkFormulaInline}[2]{%
  \noindent{\bfseries\footnotesize #1:}\enspace #2\par
}


\newcommand{\nkFormulaGroup}[3][]{%
  \ifnk@formulary@istable
  % En formato tabla no aplica bien, se muestra como una fila con multilínea
  \textbf{#2} & #3 \\
  \else
  \noindent
  {\bfseries\small #2}%
  \par\nopagebreak
  \vspace{-0.3em}%
  \begin{tabular}[t]{@{} l @{}}
    #3
  \end{tabular}%
  \def\nk@tmp@img{#1}%
  \ifx\nk@tmp@img\empty\else
  \par\nopagebreak
  \vspace{0.2em}%
%  \noindent\includegraphics[width=\nk@formulary@imwidth]{#1}% Alineada a la izquierda
  {\centering\includegraphics[width=\nk@formulary@imwidth]{#1}\par}% Centrada
  \fi
  \par
  \vspace{0.8em}%
  \fi
}


% ══════════════════════════════════════════════════════════════════════════════
% SECCIÓN: EXERCISE SET
% Contiene: entorno y comandos para crear listas de ejercicios numerados,
%           con soporte multicolumna, agrupación por tema y respuestas
%           opcionales (controladas por flag local show-answers).
% ══════════════════════════════════════════════════════════════════════════════

% ──────────────────────────────────────────────────────────────────────────────
% Contadores y flags internos
% ──────────────────────────────────────────────────────────────────────────────
\newcounter{nk@exercise}
\newif\ifnk@exerciseset@answers


% ┌─────────────────────────────────────────────────────────────────────────────
% │ \begin{nkExerciseSet}[opciones clave-valor]
% │   \nkExercise Enunciado...
% │   \nkExercise Otro enunciado...
% │ \end{nkExerciseSet}
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Entorno para crear una lista de ejercicios.
% │   - Numera automáticamente cada \nkExercise.
% │   - Soporta multicolumna.
% │   - El prefijo (capítulo, sección, etc.) se pasa manualmente.
% │   - Flag local show-answers para mostrar/ocultar respuestas.
% │
% │ Opciones (clave=valor):
% │   prefix       = {}       (prefijo numérico manual: 3 → "3.1, 3.2...")
% │   columns      = 1        (número de columnas, default: 1)
% │   colsep       = 10pt     (separación entre columnas)
% │   start        = 1        (número inicial del contador)
% │   show-answers = false     (mostrar respuestas, default: false)
% │
% │ Ejemplo:
% │   \begin{nkExerciseSet}[prefix=3, columns=2]
% │     \nkExercise Resuelve $\int x^2\,dx$.
% │     \nkExercise Calcula $\int_0^1 e^x\,dx$.
% │   \end{nkExerciseSet}
% │
% │   % Con agrupación y respuestas:
% │   \begin{nkExerciseSet}[prefix=4, show-answers]
% │     \nkExerciseGroup{Integrales}
% │     \nkExercise Resuelve $\int x^2\,dx$.
% │     \nkExerciseAnswer{$\frac{x^3}{3} + C$}
% │     \nkExercise Calcula $\int_0^1 e^x\,dx$.
% │     \nkExerciseAnswer{$e - 1$}
% │   \end{nkExerciseSet}
% └─────────────────────────────────────────────────────────────────────────────

% --- Keys del entorno ---
\pgfkeys{
  /nk/exerciseset/.cd,
  prefix/.store in   = \nk@exerciseset@prefix,
  prefix/.initial    = {},
  columns/.store in  = \nk@exerciseset@cols,
  columns/.initial   = 1,
  colsep/.store in   = \nk@exerciseset@colsep,
  colsep/.initial    = 10pt,
  start/.store in    = \nk@exerciseset@start,
  start/.initial     = 1,
  show-answers/.is if = nk@exerciseset@answers,
  show-answers/.default = true,
}

% --- Macro interna: imprime el número formateado ---
\newcommand{\nk@exercise@number}{%
  \def\nk@tmp@prefix{\nk@exerciseset@prefix}%
  \ifx\nk@tmp@prefix\empty
    \arabic{nk@exercise}%
  \else
    \nk@exerciseset@prefix.\arabic{nk@exercise}%
  \fi
}

% --- Entorno principal ---
\newenvironment{nkExerciseSet}[1][]{%
  % Procesar opciones
  \pgfkeys{/nk/exerciseset/.cd,
    prefix={}, columns=1, colsep=10pt, start=1, show-answers=false, #1}%
  %
  % Inicializar contador (start - 1 porque \nkExercise hace stepcounter)
  \setcounter{nk@exercise}{\numexpr\nk@exerciseset@start - 1\relax}%
  %
  % Configurar columnsep
  \setlength{\columnsep}{\nk@exerciseset@colsep}%
  %
  % Abrir multicols si columns > 1
  \ifnum\nk@exerciseset@cols>1
    \begin{multicols}{\nk@exerciseset@cols}
  \fi
  \setlength{\parindent}{0pt}%
}{%
  % Cerrar multicols si columns > 1
  \ifnum\nk@exerciseset@cols>1
    \end{multicols}
  \fi
}


% ┌─────────────────────────────────────────────────────────────────────────────
% │ \nkExercise
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Imprime el número del ejercicio y permite escribir inline.
% │   - Incrementa el contador automáticamente.
% │   - El texto que sigue queda en la misma línea que el número.
% │   - Se separa del ejercicio anterior con \medskip.
% │
% │ Ejemplo:
% │   \nkExercise Resuelve $\int x^2\,dx$.
% │   \nkExercise Calcula la derivada de $f(x) = e^{x^2}$.
% └─────────────────────────────────────────────────────────────────────────────
\newcommand{\nkExercise}{%
  \stepcounter{nk@exercise}%
  \ifnum\value{nk@exercise}=1\noindent\else\medskip\noindent\fi
  \textbf{\nk@exercise@number.}\enspace
}


% ┌─────────────────────────────────────────────────────────────────────────────
% │ \nkExerciseGroup[restart]{título}
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Imprime un subtítulo para agrupar ejercicios por tema.
% │   - No reinicia el contador por defecto.
% │   - Con la opción [restart], reinicia el sub-contador a 0.
% │
% │ Ejemplo:
% │   \nkExerciseGroup{Integrales definidas}
% │   \nkExercise ...
% │
% │   \nkExerciseGroup[restart]{Integrales impropias}
% │   \nkExercise ...   % reinicia numeración
% └─────────────────────────────────────────────────────────────────────────────
\newcommand{\nkExerciseGroup}[2][]{%
  \def\nk@tmp@restart{#1}%
  \def\nk@val@restart{restart}%
  \ifx\nk@tmp@restart\nk@val@restart
    \setcounter{nk@exercise}{0}%
  \fi
  \bigskip\noindent
  {\bfseries #2}%
  \par\nopagebreak
  \vspace{0.4em}%
  \hrule height 0.3pt\relax
  \vspace{0.6em}%
}


% ┌─────────────────────────────────────────────────────────────────────────────
% │ \nkExerciseAnswer{respuesta}
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Muestra la respuesta de un ejercicio.
% │   - Controlado por el flag local show-answers del nkExerciseSet.
% │   - Si show-answers=true: muestra la respuesta con ícono y color.
% │   - Si show-answers=false: no muestra nada (modo estudio/examen).
% │
% │ Ejemplo:
% │   \nkExercise Resuelve $\int x^2\,dx$.
% │   \nkExerciseAnswer{$\frac{x^3}{3} + C$}
% └─────────────────────────────────────────────────────────────────────────────
\newcommand{\nkExerciseAnswer}[1]{%
  \ifnk@exerciseset@answers
    \par\nopagebreak
    \vspace{0.2em}%
    \noindent\hspace{1.5em}%
    {\small\textbf{Respuesta:}\enspace #1}%
    \par
  \fi
}
