\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rsc/pckg/template-package/noteskit-sections}[2026/07/08 NotesKit - Módulo de secciones]

% ══════════════════════════════════════════════════════════════════════════════
% MÓDULO: noteskit-sections
% Contiene: comandos y entornos para estructurar secciones de notas
%           (objetivos, paquetes referenciados, etc.)
% Dependencias: xcolor, tcolorbox, fontawesome5 (cargados por noteskit.sty)
% ══════════════════════════════════════════════════════════════════════════════

% ┌─────────────────────────────────────────────────────────────────────────────
% │ \nkLatexPackage{nombre}
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Muestra un nombre de paquete LaTeX con estilo inline (ícono +
% │              fuente monoespaciada). Útil para mencionar paquetes en el texto.
% │ Configurable: color-principal (default: Violet) — color del ícono y texto.
% │ Ejemplo:
% │   El paquete \nkLatexPackage{tcolorbox} permite crear cajas con estilo.
% └─────────────────────────────────────────────────────────────────────────────
\newcommand{\nkLatexPackage}[1]{%		
	\tcbox[
	on line,
	colback=gray!10,
	colframe=gray!10,
	boxrule=0pt,
	boxsep=0pt,
	left=0pt,
	right=0pt,
	top=0pt,
	bottom=0pt
	]{%
		\color{\nk@colorprincipal}
		\faBox\space
		{\fontfamily{SourceCodePro-TLF}%
			\fontseries{el}% Available series: el (extra-light), l (light), m (regular), sb (semibold), b (bold), bx (black).
			\fontsize{\dimexpr\f@size pt + 0pt\relax}{\dimexpr\f@size pt + 0pt\relax}%
			\selectfont #1%
		}%
	}%
}

% ┌─────────────────────────────────────────────────────────────────────────────
% │ \begin{nkObjective}[tcolorbox opts]
% │   contenido
% │ \end{nkObjective}
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Caja numerada para declarar objetivos de una sección.
% │              Se numera automáticamente como sección.objetivo (ej: 2.1).
% │              El contador se reinicia con cada nueva \section.
% │ Configurable: color-secundario (default: black!30) — color del borde.
% │ Ejemplo:
% │   \begin{nkObjective}
% │     Comprender las propiedades de los espacios vectoriales.
% │   \end{nkObjective}
% └─────────────────────────────────────────────────────────────────────────────
\RequirePackage{tcolorbox}
% Se utiliza para resaltar los objetivos de la sección
\newcounter{objective}[section]
\renewcommand{\theobjective}{\thesection.\arabic{objective}}

\newtcolorbox{nkObjective}[1][]{%
	before upper={\refstepcounter{objective}\setlength{\parskip}{0pt}},
	title={\large\textbf{Objetivo~\theobjective}},
	colback=white,
	colframe=\nk@colorsecundario,
	fontupper=\itshape,
	left=10pt,
	#1
}

% ┌─────────────────────────────────────────────────────────────────────────────
% │ \begin{definition}[term]
% |   definition
% │ \end{definition}
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Define un entorno de teorema, con letra normal (no itálica)
% │              Se muestra con la etiqueta "Definición"
% │              Se numera reiniciándose en cada capítulo
% │ Configurable: -
% │ Ejemplo:
% │   \begin{definition}[Domain-Driven Design]
% |     \label{def:ddd}	
% │     Un grupo es un conjunto $G$ junto con una operación...
% │   \end{definition}
% └─────────────────────────────────────────────────────────────────────────────
\RequirePackage{amsthm}
% Establece el estilo visual para los teoremas que se definen a continuación.
% El estilo definition usa texto fuente normal, no itálica, a diferencia de
% plain que usa itálica
\theoremstyle{definition} 
% {nombre del entorno}{etiqueta que se imprime}{contador padre}
\newtheorem{definition}{Definición}[chapter]

% ┌─────────────────────────────────────────────────────────────────────────────
% │ \begin{nkTable}{|X[l,m,2]|X[c,m,1]|X[l,m,4]|}{Ejemplo de tabla.}{tab:ejemplo}
    % │   xtbf{Nombre} & \textbf{Acrónimo} & \textbf{Significado} \\ 
    % │   Java Development Kit & JDK & Software para programadores. \\  
    % │   Java Runtime Environment & JRE & Software para ejecutar programas Java. \\    
    % │ \end{nkTable}% │ 
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: 
% │              
% │              
% │ Configurable: -
% │ Ejemplo:
% │   
% |     
% │     
% │   
% └─────────────────────────────────────────────────────────────────────────────
% \nkTable[width]{colspec}{caption}{contenido de filas}
\newenvironment{nkTable}[4][0.95\textwidth]{%
    % #1 = width (opcional, default 0.95\textwidth)
    % #2 = colspec
    % #3 = caption
    % #4 = label
    \def\nk@tbl@caption{#3}%
    \def\nk@tbl@label{#4}%
    \begin{table}[H]
        \centering
        \begin{tblr}{
                width = #1,
                colspec = {#2},
                hlines,
                vlines,
                rows = {m},
                row{odd} = {bg=gray!30},
                row{1} = {font=\bfseries, bg=gray!60, c},
            }
        }{%
        \end{tblr}
        \caption{\nk@tbl@caption}
        \label{\nk@tbl@label}
    \end{table}
}

% ┌─────────────────────────────────────────────────────────────────────────────
% │ \begin{nkQuestion}{texto de la pregunta}
% │   \nkAnswer[correct]{respuesta correcta}
% │   \nkAnswer{respuesta incorrecta}
% │ \end{nkQuestion}
% ├─────────────────────────────────────────────────────────────────────────────
% │ Descripción: Entorno para preguntas con una o más respuestas.
% │              Soporta opción múltiple (una o varias correctas) y respuesta única.
% │              Con el flag \nk@showAnswersfalse se ocultan las marcas de
% │              correcto/incorrecto (modo estudio).
% │ Configurable: -
% │ Ejemplo:
% │   \begin{nkQuestion}{¿Qué es un submódulo de git?}
% │     \nkAnswer[correct]{Un repositorio dentro de otro repositorio.}
% │     \nkAnswer{Una rama protegida.}
% │   \end{nkQuestion}
% └─────────────────────────────────────────────────────────────────────────────

% Flag para mostrar/ocultar respuestas (true = muestra, false = oculta)
%\newif\ifnk@showAnswers
%\nk@showAnswerstrue

% Contador de preguntas (se reinicia por sección)
\newcounter{nkquestion}[section]
\renewcommand{\thenkquestion}{\thesection.\arabic{nkquestion}}

% Entorno de pregunta
%   #1 = (opcional) tipo: "open" para pregunta abierta. Default: opción múltiple.
%   #2 = texto de la pregunta
\newenvironment{nkQuestion}[2][]{%
    \def\nk@question@type{#1}%
    \def\nk@question@open{open}%
    \refstepcounter{nkquestion}%
    \par\medskip\noindent
    \textbf{Pregunta~\thenkquestion:} #2%
    \begin{itemize}
    }{%
    \end{itemize}
    \medskip
}

% Comando de respuesta
\newcommand{\nkAnswer}[2][]{%
    \def\nk@tmp{#1}%
    \def\nk@correct{correct}%
    \ifnk@showAnswers
    % Modo respuestas: muestra check/cross
    \ifx\nk@tmp\nk@correct
    \item[\textcolor{green!60!black}{\faCheck}] #2%
    \else
    \item[\textcolor{red!70!black}{\faTimes}] #2%
    \fi
    \else
    % Modo estudio:
    \ifx\nk@question@type\nk@question@open
    % Pregunta abierta: muestra línea en blanco
    \item \rule{5cm}{0.4pt}%
    \else
    % Opción múltiple: muestra opciones sin marcar
    \item #2%
    \fi
    \fi
}





